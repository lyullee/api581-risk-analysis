{
  "TwinMeasurement": {
    "additionalProperties": false,
    "properties": {
      "measurement_id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Measurement Id",
        "type": "string"
      },
      "quantity": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Quantity",
        "type": "string"
      },
      "value": {
        "title": "Value",
        "type": "number"
      },
      "unit": {
        "maxLength": 50,
        "minLength": 1,
        "title": "Unit",
        "type": "string"
      },
      "measured_at": {
        "format": "date-time",
        "title": "Measured At",
        "type": "string"
      },
      "source": {
        "maxLength": 500,
        "minLength": 1,
        "title": "Source",
        "type": "string"
      },
      "quality": {
        "enum": [
          "measured",
          "estimated",
          "simulated"
        ],
        "title": "Quality",
        "type": "string"
      },
      "uncertainty": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Uncertainty"
      }
    },
    "required": [
      "measurement_id",
      "quantity",
      "value",
      "unit",
      "measured_at",
      "source",
      "quality"
    ],
    "title": "TwinMeasurement",
    "type": "object"
  },
